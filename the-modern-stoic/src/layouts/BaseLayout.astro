---
// Latin subsets only, and Fraunces' `wght` axis rather than the full variable
// font: the site never sets optical size, softness or wonk, and the full face
// is 118KB against 36KB for the axis we actually animate.
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource/source-serif-4/latin-400.css';
import '@fontsource/source-serif-4/latin-400-italic.css';
import '@fontsource/source-serif-4/latin-600.css';
import '@/styles/global.css';

// The two faces that render above the fold. Preloading them removes a round
// trip from the LCP path — without it the browser only discovers the font
// after parsing the stylesheet.
import frauncesWght from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import interRegular from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import { brandConfig } from '@/config/brand.config';
import SEO from '@/components/SEO.astro';
import AnalyticsScripts from '@/components/AnalyticsScripts.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CookieConsent from '@/components/CookieConsent.vue';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, ogImage, jsonLd, noindex } = Astro.props;
const { colors, fonts } = brandConfig.theme;

// Only warm up Google's origins when a tag is actually configured — an unused
// preconnect is a wasted connection, and Lighthouse flags it as one.
const analyticsEnabled = Boolean(
  brandConfig.analytics.ga4Id || brandConfig.analytics.gtmId,
);

// Every shadcn token is assigned here, not just a handful. Anything left out
// falls back to shadcn's neutral-gray defaults in global.css and renders cold
// gray against the warm paper background.
//
// Note `--accent` keeps its shadcn meaning (a subtle hover surface) rather than
// holding the bronze; the brand accent lives on `--brand-accent` so that ghost
// buttons and menu items don't pick up a bronze background.
const brandStyles = `:root {
  --background: ${colors.background};
  --foreground: ${colors.text};
  --surface: ${colors.surface};
  --panel: ${colors.panel};
  --ink: ${colors.ink};
  --brand-accent: ${colors.accent};
  --brand-accent-soft: ${colors.accentSoft};

  --primary: ${colors.primary};
  --primary-foreground: ${colors.surface};
  --secondary: ${colors.panel};
  --secondary-foreground: ${colors.primary};
  --accent: ${colors.panel};
  --accent-foreground: ${colors.primary};
  --muted: ${colors.panel};
  --muted-foreground: ${colors.mutedText};
  --card: ${colors.surface};
  --card-foreground: ${colors.text};
  --popover: ${colors.surface};
  --popover-foreground: ${colors.text};
  --border: ${colors.border};
  --border-strong: ${colors.borderStrong};
  --input: ${colors.border};
  --ring: ${colors.accent};

  --brand-font-heading: '${fonts.heading}';
  --brand-font-body: '${fonts.body}';
  --brand-font-serif-body: '${fonts.serifBody}';
}`;
---

<!doctype html>
<html lang={brandConfig.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={brandConfig.theme.faviconUrl} />
    <meta name="theme-color" content={colors.background} />
    <link rel="preload" as="font" type="font/woff2" href={frauncesWght} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={interRegular} crossorigin="anonymous" />
    {analyticsEnabled && (
      <>
        <link rel="preconnect" href="https://www.googletagmanager.com" />
        <link rel="preconnect" href="https://www.google-analytics.com" crossorigin="anonymous" />
      </>
    )}
    <SEO title={title} description={description} ogImage={ogImage} jsonLd={jsonLd} noindex={noindex} />
    <AnalyticsScripts />
    <style set:html={brandStyles} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieConsent client:idle />
  </body>
</html>
