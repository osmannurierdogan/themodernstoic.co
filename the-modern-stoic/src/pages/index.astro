---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NewsletterForm from '@/components/NewsletterForm.astro';
import PostCard from '@/components/PostCard.astro';
import { brandConfig } from '@/config/brand.config';
import { getPublishedPosts } from '@/lib/posts';

const posts = (await getPublishedPosts()).slice(0, 6);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: brandConfig.brandName,
    url: `https://${brandConfig.domain}`,
    logo: brandConfig.theme.logoUrl,
    sameAs: Object.values(brandConfig.social).filter(Boolean),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: brandConfig.brandName,
    url: `https://${brandConfig.domain}`,
    potentialAction: {
      '@type': 'SearchAction',
      target: `https://${brandConfig.domain}/blog?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
];
---

<BaseLayout title={brandConfig.brandName} description={brandConfig.tagline} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="mx-auto max-w-grid px-6 pt-section pb-20 lg:pt-section-lg">
    <div class="max-w-3xl">
      <p class="eyebrow text-brand">Est. Stoa &middot; Practised Today</p>
      <h1 class="mt-6 font-heading text-h1 font-semibold text-foreground lg:text-display">
        {brandConfig.tagline}
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-relaxed text-muted-foreground">
        Essays on the Stoics and what their discipline asks of us now — read slowly,
        one idea at a time.
      </p>
      <div class="mt-10 h-px w-24 bg-brand-soft"></div>
    </div>
  </section>

  <!-- Latest essays -->
  <section class="mx-auto max-w-grid px-6 pb-section lg:pb-section-lg">
    <div class="mb-10 flex items-end justify-between gap-6 border-b border-border pb-5">
      <h2 class="eyebrow text-foreground">Latest essays</h2>
      <a href="/blog" class="eyebrow text-brand transition-opacity hover:opacity-70">
        All essays &rarr;
      </a>
    </div>

    {posts.length === 0 ? (
      <p class="text-muted-foreground">
        No essays published yet — connect your Notion database to see them here.
      </p>
    ) : (
      <ul class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <li class="h-full">
            <PostCard post={post} />
          </li>
        ))}
      </ul>
    )}
  </section>

  <!-- Newsletter: the one high-contrast moment on the page -->
  <section class="bg-ink">
    <div class="mx-auto max-w-grid px-6 py-section">
      <div class="max-w-xl">
        <p class="eyebrow text-brand-soft">The Newsletter</p>
        <h2 class="mt-5 font-heading text-h2 font-semibold text-white">
          One essay, every week.
        </h2>
        <p class="mt-4 text-white/60">
          Ancient wisdom, applied to the week you are actually having.
        </p>
        <div class="mt-8">
          <NewsletterForm tone="ink" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
