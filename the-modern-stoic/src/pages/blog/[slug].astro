---
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { brandConfig } from '@/config/brand.config';
import { formatArtworkCredit } from '@/config/artwork';
import { getPublishedPosts, getPostSlug, getPostImage } from '@/lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Title, Excerpt, PublishDate, Tags } = post.data.properties;
const { Content } = await render(post);
const image = getPostImage(post);
const publishDateIso = PublishDate?.start.toISOString();

// The article column is 720px at its widest.
const coverWidth = Math.min(720, image.src.width);

// Social cards want a fixed 1.91:1 crop, not the responsive set the page uses.
const ogAsset = await getImage({
  src: image.src,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
});

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: Title,
    description: Excerpt,
    datePublished: publishDateIso,
    image: new URL(ogAsset.src, Astro.site).toString(),
    author: { '@type': 'Person', name: brandConfig.brandName },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Essays', item: `https://${brandConfig.domain}/blog` },
      { '@type': 'ListItem', position: 2, name: Title },
    ],
  },
];
---

<BaseLayout title={Title} description={Excerpt} ogImage={ogAsset.src} jsonLd={jsonLd}>
  <article class="mx-auto max-w-article px-6 py-section lg:py-section-lg">
    <header class="mb-12">
      {Tags.length > 0 && (
        <div class="mb-5 flex flex-wrap gap-x-3 gap-y-2">
          {Tags.map((tag: string) => (
            <a href={`/blog?tag=${encodeURIComponent(tag)}`} class="eyebrow text-brand hover:opacity-70">
              {tag}
            </a>
          ))}
        </div>
      )}
      <h1 class="font-heading text-h1 font-semibold">{Title}</h1>
      {Excerpt && (
        <p class="mt-6 text-lg leading-relaxed text-muted-foreground">{Excerpt}</p>
      )}
      {publishDateIso && (
        <time datetime={publishDateIso} class="eyebrow mt-8 block">
          {new Date(publishDateIso).toLocaleDateString(brandConfig.language, {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      )}
      <div class="mt-8 h-px w-full bg-border"></div>
    </header>

    <figure class="mb-12">
      <div class="overflow-hidden rounded-md bg-panel">
        <Image
          src={image.src}
          alt={image.alt}
          width={coverWidth}
          height={Math.round(coverWidth / (16 / 9))}
          fit="cover"
          position="center"
          widths={[400, 640, 960, 1280, 1440].filter((w) => w <= Math.min(image.src.width, 1440))}
          sizes="(min-width: 768px) 720px, 100vw"
          loading="eager"
          decoding="sync"
          fetchpriority="high"
          class="h-auto w-full"
        />
      </div>
      {image.artwork && (
        <figcaption class="mt-3 text-xs leading-relaxed text-muted-foreground">
          <cite class="not-italic">{image.artwork.title}</cite>
          <span>, {formatArtworkCredit(image.artwork)}</span>
          <span aria-hidden="true"> &middot; </span>
          <a
            href={image.artwork.sourceUrl}
            class="underline underline-offset-2 transition-colors hover:text-brand"
            rel="noopener noreferrer"
            target="_blank"
          >
            {image.artwork.collection}
          </a>
          <span> ({image.artwork.license})</span>
        </figcaption>
      )}
    </figure>

    <div class="prose prose-brand">
      <Content />
    </div>

    <div class="mt-16 border-t border-border pt-8">
      <a href="/blog" class="eyebrow text-brand hover:opacity-70">&larr; All essays</a>
    </div>
  </article>
</BaseLayout>
