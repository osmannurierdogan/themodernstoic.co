---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { brandConfig } from '@/config/brand.config';
import { getPublishedPosts, getPostSlug, getPostCoverUrl } from '@/lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Title, Excerpt, PublishDate, Tags } = post.data.properties;
const { Content } = await render(post);
const coverUrl = getPostCoverUrl(post);
const publishDateIso = PublishDate?.start.toISOString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: Title,
    description: Excerpt,
    datePublished: publishDateIso,
    image: coverUrl,
    author: { '@type': 'Person', name: brandConfig.brandName },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Essays', item: `https://${brandConfig.domain}/blog` },
      { '@type': 'ListItem', position: 2, name: Title },
    ],
  },
];
---

<BaseLayout title={Title} description={Excerpt} ogImage={coverUrl} jsonLd={jsonLd}>
  <article class="mx-auto max-w-2xl px-6 py-16">
    <header class="mb-10">
      {Tags.length > 0 && (
        <div class="mb-4 flex flex-wrap gap-2 text-xs text-foreground/60">
          {Tags.map((tag: string) => <span>{tag}</span>)}
        </div>
      )}
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{Title}</h1>
      {publishDateIso && (
        <time datetime={publishDateIso} class="mt-3 block text-sm text-foreground/60">
          {new Date(publishDateIso).toLocaleDateString(brandConfig.language, {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      )}
    </header>
    {coverUrl && (
      <img src={coverUrl} alt={Title} class="mb-8 w-full rounded-md object-cover aspect-video" />
    )}
    <div class="prose prose-neutral max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
