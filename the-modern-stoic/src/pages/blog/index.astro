---
// Tag/page filtering reads query params, so this route needs on-demand
// rendering rather than the site's default static prerendering.
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Artwork from '@/components/Artwork.astro';
import PostCard from '@/components/PostCard.astro';
import { artwork } from '@/config/artwork';
import { brandConfig } from '@/config/brand.config';
import { getPublishedPosts } from '@/lib/posts';

const allPosts = await getPublishedPosts();

const requestedTag = Astro.url.searchParams.get('tag');
const page = Math.max(1, Number(Astro.url.searchParams.get('page') ?? '1') || 1);
const perPage = 10;

const allTags = [...new Set(allPosts.flatMap((post) => post.data.properties.Tags))].sort();

const filteredPosts = requestedTag
  ? allPosts.filter((post) => post.data.properties.Tags.includes(requestedTag))
  : allPosts;

const totalPages = Math.max(1, Math.ceil(filteredPosts.length / perPage));
const currentPage = Math.min(page, totalPages);
const paginatedPosts = filteredPosts.slice((currentPage - 1) * perPage, currentPage * perPage);

function pageHref(targetPage: number): string {
  const params = new URLSearchParams();
  if (requestedTag) params.set('tag', requestedTag);
  if (targetPage > 1) params.set('page', String(targetPage));
  const query = params.toString();
  return query ? `/blog?${query}` : '/blog';
}
---

<BaseLayout
  title="Essays"
  description={`Essays from ${brandConfig.brandName}${requestedTag ? ` tagged "${requestedTag}"` : ''}.`}
>
  <section class="mx-auto max-w-grid px-6 py-section lg:py-section-lg">
    <header class="grid items-end gap-10 border-b border-border pb-8 md:grid-cols-[1fr_auto]">
      <div>
        <p class="eyebrow text-brand">The Archive</p>
        <h1 class="mt-5 font-heading text-h1 font-semibold">Essays</h1>
        <p class="mt-5 max-w-lg text-lg leading-relaxed text-muted-foreground">
          Every essay published so far, newest first. Filter by theme below.
        </p>
        {requestedTag && (
          <p class="mt-4 text-muted-foreground">
            Filtered by <span class="text-brand">{requestedTag}</span>
          </p>
        )}
      </div>

      <Artwork
        item={artwork.aPhilosopher}
        aspect="4/5"
        displayWidth={240}
        sizes="240px"
        priority
        class="hidden w-60 md:block"
      />
    </header>

    {allTags.length > 0 && (
      <nav class="mt-8 flex flex-wrap gap-2" aria-label="Filter by tag">
        <a
          href="/blog"
          class:list={[
            'eyebrow rounded-full border px-4 py-2 transition-colors',
            !requestedTag
              ? 'border-foreground bg-foreground text-background'
              : 'border-border text-muted-foreground hover:border-border-strong hover:text-brand',
          ]}
        >
          All
        </a>
        {allTags.map((tag) => (
          <a
            href={`/blog?tag=${encodeURIComponent(tag)}`}
            class:list={[
              'eyebrow rounded-full border px-4 py-2 transition-colors',
              requestedTag === tag
                ? 'border-foreground bg-foreground text-background'
                : 'border-border text-muted-foreground hover:border-border-strong hover:text-brand',
            ]}
          >
            {tag}
          </a>
        ))}
      </nav>
    )}

    {paginatedPosts.length === 0 ? (
      <p class="mt-12 text-muted-foreground">No essays found.</p>
    ) : (
      <ul class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {paginatedPosts.map((post) => (
          <li class="h-full">
            <PostCard post={post} />
          </li>
        ))}
      </ul>
    )}

    {totalPages > 1 && (
      <nav class="mt-16 flex items-center justify-between gap-4 border-t border-border pt-8">
        {currentPage > 1 ? (
          <a href={pageHref(currentPage - 1)} rel="prev" class="eyebrow text-brand hover:opacity-70">
            &larr; Previous
          </a>
        ) : (
          <span></span>
        )}
        <span class="eyebrow">Page {currentPage} of {totalPages}</span>
        {currentPage < totalPages ? (
          <a href={pageHref(currentPage + 1)} rel="next" class="eyebrow text-brand hover:opacity-70">
            Next &rarr;
          </a>
        ) : (
          <span></span>
        )}
      </nav>
    )}
  </section>
</BaseLayout>
