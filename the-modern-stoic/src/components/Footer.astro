---
import Logo from '@/components/Logo.astro';
import { brandConfig } from '@/config/brand.config';
import { getNavPages } from '@/lib/pages';

const year = new Date().getFullYear();
const socialLinks = Object.entries(brandConfig.social).filter(([, url]) => Boolean(url));
const footerPages = await getNavPages('footer');

const linkClass = 'text-sm text-muted-foreground transition-colors hover:text-brand';
---

<footer class="mt-auto border-t border-border bg-panel">
  <div class="mx-auto max-w-grid px-6 py-16">
    <div class="grid gap-12 md:grid-cols-[1.5fr_1fr_1fr]">
      <div class="max-w-xs">
        <Logo />
        <p class="mt-5 text-sm leading-relaxed text-muted-foreground">
          {brandConfig.tagline}
        </p>
      </div>

      <div>
        <h2 class="eyebrow mb-4">Explore</h2>
        <nav class="flex flex-col gap-3">
          <a href="/blog" class={linkClass}>Essays</a>
          <a href="/newsletter" class={linkClass}>Newsletter</a>
          <a href={brandConfig.storeUrl} class={linkClass}>Store</a>
          <a href="/rss.xml" class={linkClass}>RSS</a>
        </nav>
      </div>

      <div>
        <h2 class="eyebrow mb-4">{socialLinks.length > 0 ? 'Elsewhere' : 'More'}</h2>
        <nav class="flex flex-col gap-3">
          {socialLinks.map(([platform, url]) => (
            <a
              href={url}
              class={`${linkClass} capitalize`}
              rel="me noopener noreferrer"
              target="_blank"
            >
              {platform}
            </a>
          ))}
          {footerPages.map((page) => (
            <a href={`/${page.data.properties.Slug}`} class={linkClass}>
              {page.data.properties.Title}
            </a>
          ))}
        </nav>
      </div>
    </div>

    <div class="mt-14 border-t border-border-strong/50 pt-8">
      <p class="eyebrow">
        &copy; {year} {brandConfig.brandName}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
