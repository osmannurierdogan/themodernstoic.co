---
import { Image } from 'astro:assets';
import { brandConfig } from '@/config/brand.config';
import { getPostSlug, getPostImage, type PostEntry } from '@/lib/posts';

interface Props {
  post: PostEntry;
  /** `lead` gives the card a wider image well and a larger title. */
  size?: 'default' | 'lead';
  /**
   * Set on the first card above the fold so its image is the eagerly loaded
   * LCP candidate. Everything below the fold stays lazy.
   */
  priority?: boolean;
}

const { post, size = 'default', priority = false } = Astro.props;

const { Title, Excerpt, PublishDate, Tags } = post.data.properties;
const image = getPostImage(post);
const href = `/blog/${getPostSlug(post)}`;
const isLead = size === 'lead';

const publishDateIso = PublishDate?.start.toISOString();
const publishDateLabel = publishDateIso
  ? new Date(publishDateIso).toLocaleDateString(brandConfig.language, {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : undefined;

const primaryTag = Tags?.[0];

// Cards are at most ~420px wide in the 3-up grid and ~640px as a lead. Cropping
// to the card's ratio here, rather than with CSS `object-cover`, means a square
// Notion cover does not ship the third of its height the card never shows.
const displayWidth = isLead ? 640 : 420;
const width = Math.min(displayWidth, image.src.width);
const height = Math.round(width / (isLead ? 16 / 9 : 3 / 2));

// w descriptors, not x descriptors: the card is full-bleed on a phone and a
// third of the grid on a desktop, so `sizes` has to be able to choose.
const maxWidth = Math.min(image.src.width, displayWidth * 2);
const widths = [...new Set([400, 640, 960, 1280].filter((w) => w <= maxWidth).concat(maxWidth))]
  .sort((a, b) => a - b);
---

<article class="h-full">
  <a
    href={href}
    class="group flex h-full flex-col overflow-hidden rounded-md border border-border bg-surface transition-colors duration-200 hover:border-border-strong"
  >
    <div class="relative overflow-hidden">
      <Image
        src={image.src}
        alt={image.alt}
        width={width}
        height={height}
        fit="cover"
        position="center"
        widths={widths}
        sizes={
          isLead
            ? '(min-width: 1024px) 640px, 100vw'
            : '(min-width: 1024px) 420px, (min-width: 768px) 50vw, 100vw'
        }
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : 'auto'}
        class="h-auto w-full transition-transform duration-500 ease-out group-hover:scale-[1.03]"
      />
    </div>

    <div class={`flex flex-1 flex-col ${isLead ? 'p-7' : 'p-6'}`}>
      {(primaryTag || publishDateLabel) && (
        <p class="eyebrow mb-3 flex items-center gap-2">
          {primaryTag && <span>{primaryTag}</span>}
          {primaryTag && publishDateLabel && (
            <span class="text-brand-soft" aria-hidden="true">&middot;</span>
          )}
          {publishDateLabel && <time datetime={publishDateIso}>{publishDateLabel}</time>}
        </p>
      )}

      <h3
        class={`font-heading font-semibold text-foreground transition-colors duration-200 group-hover:text-brand ${
          isLead ? 'text-h2' : 'text-h3'
        }`}
      >
        {Title}
      </h3>

      {Excerpt && (
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          {Excerpt}
        </p>
      )}

      <span class="eyebrow mt-auto pt-6 text-brand">Read essay &rarr;</span>
    </div>
  </a>
</article>
