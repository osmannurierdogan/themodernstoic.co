---
import { brandConfig } from '@/config/brand.config';
import { getPostSlug, getPostCoverUrl, type PostEntry } from '@/lib/posts';

interface Props {
  post: PostEntry;
  /** `lead` gives the card a wider image well and a larger title. */
  size?: 'default' | 'lead';
}

const { post, size = 'default' } = Astro.props;

const { Title, Excerpt, PublishDate, Tags } = post.data.properties;
const coverUrl = getPostCoverUrl(post);
const href = `/blog/${getPostSlug(post)}`;
const isLead = size === 'lead';

const publishDateIso = PublishDate?.start.toISOString();
const publishDateLabel = publishDateIso
  ? new Date(publishDateIso).toLocaleDateString(brandConfig.language, {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : undefined;

const primaryTag = Tags?.[0];

// Monogram for the no-cover fallback, so a coverless post still occupies the
// same vertical space and the grid row stays aligned.
const monogram = brandConfig.brandName
  .split(' ')
  .map((word) => word[0])
  .join('')
  .slice(0, 3)
  .toUpperCase();
---

<article class="h-full">
  <a
    href={href}
    class="group flex h-full flex-col overflow-hidden rounded-md border border-border bg-surface transition-colors duration-200 hover:border-border-strong"
  >
    <div class={`relative overflow-hidden ${isLead ? 'aspect-[16/9]' : 'aspect-[3/2]'}`}>
      {coverUrl ? (
        <img
          src={coverUrl}
          alt={Title}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-panel">
          <span class="font-heading text-2xl tracking-[0.2em] text-brand-soft" aria-hidden="true">
            {monogram}
          </span>
        </div>
      )}
    </div>

    <div class={`flex flex-1 flex-col ${isLead ? 'p-7' : 'p-6'}`}>
      {(primaryTag || publishDateLabel) && (
        <p class="eyebrow mb-3 flex items-center gap-2">
          {primaryTag && <span>{primaryTag}</span>}
          {primaryTag && publishDateLabel && (
            <span class="text-brand-soft" aria-hidden="true">&middot;</span>
          )}
          {publishDateLabel && <time datetime={publishDateIso}>{publishDateLabel}</time>}
        </p>
      )}

      <h3
        class={`font-heading font-semibold text-foreground transition-colors duration-200 group-hover:text-brand ${
          isLead ? 'text-h2' : 'text-h3'
        }`}
      >
        {Title}
      </h3>

      {Excerpt && (
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          {Excerpt}
        </p>
      )}

      <span class="eyebrow mt-auto pt-6 text-brand">Read essay &rarr;</span>
    </div>
  </a>
</article>
