  "description": "Scaffold a config-driven, Notion-as-CMS Astro brand site (blog + newsletter + landing) with one command.",
  "keywords": [
    "astro",
    "astro-template",
    "cli",
    "scaffold",
    "notion",
    "notion-cms",
    "blog",
    "create-astro"
  ],
  "license": "MIT",
  "author": "Osman Nuri Erdoğan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osmannurierdogan/blogfactory.git"
  },
  "homepage": "https://github.com/osmannurierdogan/blogfactory#readme",
  "bugs": {
    "url": "https://github.com/osmannurierdogan/blogfactory/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "bin",
    "scripts",
    "src",
    "public",
    "astro.config.mjs",
    "tsconfig.json",
    "components.json",
    ".env.example"
  ],
  "scripts": {
